{
  "rules": {
    ".read": false,
    ".write": false,
    "state":   { ".read": "auth != null && root.child('allowed').child(auth.uid).val() === true" },
    "events":  { ".read": "auth != null && root.child('allowed').child(auth.uid).val() === true" },
    "result":  { ".read": "auth != null && root.child('allowed').child(auth.uid).val() === true" },
    "cmd":     { ".read": "auth != null && root.child('allowed').child(auth.uid).val() === true",
                 ".write": "auth != null && root.child('allowed').child(auth.uid).val() === true" },
    "allowed": { ".read": false, ".write": false },
    "pair": {
      "$code": {
        ".read": "auth != null",
        "watch": { ".write": "auth != null" }
      }
    }
  }
}
