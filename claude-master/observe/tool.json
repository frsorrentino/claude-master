{
  "name": "claude-master",
  "repo": "frsorrentino/claude-master",
  "command": "claude-master observe",
  "version_from": ".claude-plugin/plugin.json",
  "match": {
    "bash": ["(^|\\s|/)claude-master(\\s|$)", "/scripts/cm-[\\w-]+\\.(sh|py)\\b"]
  },
  "benign_exits": {"restart arm": [4], "model": [2, 3], "effort": [2, 3], "close": [3, 4]},
  "known": []
}
