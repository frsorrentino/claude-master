#!/usr/bin/env bash
# `bin/` di un plugin sta nel PATH del tool Bash mentre il plugin e' attivo (E4):
# dentro una sessione `claude-master ...` funziona senza shim. Nel terminale
# dell'utente serve ancora `~/.local/bin/claude-master` (init --shim).
exec "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../scripts/claude-master" "$@"
